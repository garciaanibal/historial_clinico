{% extends 'base.html.twig' %}

{% block title %}{% endblock %}
{% block stylesheets %}
    <style>
    
        body {
        height: 100%; /* Asegura que el body y html ocupen toda la altura */
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        /* background-color: #f8f9fa; Color de fondo por defecto */
    }

    .login-container {
        background: url('../images/medical_background.jpg') no-repeat center center fixed; /* Ruta a tu imagen de fondo */
        background-size: cover; /* Cubre todo el contenedor */
        display: flex; /* Para centrar el contenido */
        justify-content: center; /* Centrar horizontalmente */
        align-items: center; /* Centrar verticalmente */
        min-height: 100vh; /* Ocupa al menos el 100% de la altura de la ventana */
        padding: 20px;
    }

    .login-box {
        background-color: rgba(255, 255, 255, 0.6); /* Transparencia para el fondo */
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        max-width: 450px;
        width: 100%;
        text-align: left;
        /* Estilos para centrar el contenido */
        display: flex;
        flex-direction: column;
        align-items: center; /* Centra horizontalmente los elementos dentro del login-box */
    }

    .form-group {
        margin-bottom: 20px; /* Aumenta el espacio entre grupos de campos */
        text-align: left; /* Asegura que la etiqueta y el input se alineen a la izquierda */
        width: 100%;
    }

    /* Mejora el estilo de las etiquetas */
    .login-box .form-group label {
        font-weight: 500;
        color: #495057;
        margin-bottom: 8px; /* Espacio entre la etiqueta y el input */
        display: block; /* La etiqueta se muestra en su propia línea */
    }

    /* Asegura que los campos tengan el mismo tamaño */
    .login-box .form-control {
        display: block; /* Hace que el input ocupe todo el ancho disponible */
        width: 100%; /* El input se ajusta al 100% de su contenedor */
        padding: 12px 15px;
        border-radius: 5px;
        border: 1px solid #ced4da;
    }

    /* Asegura que el botón también tenga el mismo ancho */
    .login-box .btn-primary {
        display: block;
        padding: 12px 15px;
    }
    </style>
{% endblock %}

{% block body %}
    <div class="login-container" style="background-image: url('{{ asset('/img/bg_login.png') }}');">
        <div class="login-box">
            <form method="post">
                <h1 class="h3 mb-3 font-weight-normal text-center">¡Bienvenido!</h1>
                <p class="text-center mb-4">Inicia sesión para acceder a tu cuenta.</p>

                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3 text-center">
                        Has iniciado sesión como {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Cerrar sesión</a>
                    </div>
                {% endif %}

                <div class="form-group mb-3">
                    <label for="username">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
                </div>

                <div class="form-group mb-4">
                    <label for="password">Contraseña</label>
                    <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                {# Si usas "Remember Me", descomenta esta sección en tu security.yaml y aquí #}
                {#
                <div class="checkbox mb-3">
                    <input type="checkbox" name="_remember_me" id="_remember_me">
                    <label for="_remember_me">Recordarme</label>
                </div>
                #}

                <button class="btn btn-lg btn-primary w-100" type="submit">
                    Acceder
                </button>
            </form>
        </div>
    </div>
{% endblock %}
